generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum ReportCategory {
  ROAD_DAMAGE
  FLOODING
  GARBAGE
  STREETLIGHT
  DRAINAGE
  FALLEN_TREE
  WATER
  OTHER
}

enum ReportStatus {
  REPORTED
  UNDER_VERIFICATION
  VERIFIED
  REJECTED
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  DUPLICATE
}

enum VerificationResult {
  CONFIRMED
  REJECTED
  DUPLICATE
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(50)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")

  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(100)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       Int @map("role_id")
  permissionId Int @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id           String     @id @default(uuid()) @db.VarChar(36)
  roleId       Int        @map("role_id")
  name         String     @db.VarChar(100)
  email        String     @unique @db.VarChar(150)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  role Role @relation(fields: [roleId], references: [id])

  reportsAsReporter Report[] @relation("ReporterRelation")
  reportsAsAssignee Report[] @relation("AssigneeRelation")

  verifications        ReportVerification[]  @relation("ValidatorRelation")
  comments             ReportComment[]
  statusHistoryChanges ReportStatusHistory[] @relation("StatusChangedByRelation")
  auditLogs            AuditLog[]

  @@map("users")
}

model Report {
  id          String         @id @default(uuid()) @db.VarChar(36)
  reporterId  String         @map("reporter_id") @db.VarChar(36)
  category    ReportCategory
  title       String         @db.VarChar(150)
  description String         @db.Text
  latitude    Decimal        @db.Decimal(10, 7)
  longitude   Decimal        @db.Decimal(10, 7)
  status      ReportStatus   @default(REPORTED)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  assignedToId String?   @map("assigned_to") @db.VarChar(36)
  assignedAt   DateTime? @map("assigned_at")

  reporter   User  @relation("ReporterRelation", fields: [reporterId], references: [id], onDelete: Restrict)
  assignedTo User? @relation("AssigneeRelation", fields: [assignedToId], references: [id], onDelete: SetNull)

  verifications ReportVerification[]
  comments      ReportComment[]
  statusHistory ReportStatusHistory[]

  @@index([status])
  @@index([reporterId])
  @@index([assignedToId])

  @@map("reports")
}

model ReportVerification {
  id          String             @id @default(uuid()) @db.VarChar(36)
  reportId    String             @map("report_id") @db.VarChar(36)
  validatorId String             @map("validator_id") @db.VarChar(36)
  result      VerificationResult
  comment     String?            @db.Text
  createdAt   DateTime           @default(now()) @map("created_at")

  report    Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  validator User   @relation("ValidatorRelation", fields: [validatorId], references: [id], onDelete: Restrict)

  @@unique([reportId, validatorId]) 
  @@index([reportId])
  @@index([validatorId])

  @@map("report_verifications")
}

model ReportComment {
  id        String   @id @default(uuid()) @db.VarChar(36)
  reportId  String   @map("report_id") @db.VarChar(36)
  userId    String   @map("user_id") @db.VarChar(36)
  comment   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([reportId])
  @@index([userId])

  @@map("report_comments")
}

model ReportStatusHistory {
  id        String        @id @default(uuid()) @db.VarChar(36)
  reportId  String        @map("report_id") @db.VarChar(36)
  changedBy String        @map("changed_by") @db.VarChar(36)
  oldStatus ReportStatus? @map("old_status")
  newStatus ReportStatus  @map("new_status")
  remarks   String?       @db.VarChar(255)
  createdAt DateTime      @default(now()) @map("created_at")

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  author User   @relation("StatusChangedByRelation", fields: [changedBy], references: [id], onDelete: Restrict)

  @@index([reportId])
  @@index([changedBy])

  @@map("report_status_history")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.VarChar(36)
  userId     String   @map("user_id") @db.VarChar(36)
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   String?  @map("entity_id") @db.VarChar(191)
  details    String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([entityType, entityId])

  @@map("audit_logs")
}