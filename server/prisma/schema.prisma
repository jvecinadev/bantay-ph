generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum ReportCategory {
  ROAD_DAMAGE
  FLOODING
  GARBAGE
  STREETLIGHT
  DRAINAGE
  FALLEN_TREE
  WATER
  OTHER
}

enum ReportStatus {
  REPORTED
  UNDER_VERIFICATION
  VERIFIED
  REJECTED
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  DUPLICATE
}

enum VerificationResult {
  CONFIRMED
  REJECTED
  DUPLICATE
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(50)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")

  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(100)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       Int @map("role_id")
  permissionId Int @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id           String     @id @default(uuid()) @db.VarChar(36)
  roleId       Int        @map("role_id")
  name         String     @db.VarChar(100)
  email        String     @unique @db.VarChar(150)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  role Role @relation(fields: [roleId], references: [id])

  reportsAsReporter Report[] @relation("ReporterRelation")
  reportsAsAssignee Report[] @relation("AssigneeRelation")
  deletedReports Report[] @relation("ReportDeletedByRelation")

  verifications        ReportVerification[]  @relation("ValidatorRelation")
  comments             ReportComment[]
  statusHistoryChanges ReportStatusHistory[] @relation("StatusChangedByRelation")
  auditLogs            AuditLog[]

  profile  UserProfile?
  settings UserSettings?

  @@map("users")
}

model Report {
  id          String         @id @default(uuid()) @db.VarChar(36)
  reporterId  String         @map("reporter_id") @db.VarChar(36)
  category    ReportCategory
  title       String         @db.VarChar(150)
  description String         @db.Text
  latitude    Decimal        @db.Decimal(10, 7)
  longitude   Decimal        @db.Decimal(10, 7)
  status      ReportStatus   @default(REPORTED)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  assignedToId String?   @map("assigned_to") @db.VarChar(36)
  assignedAt   DateTime? @map("assigned_at")

  deletedAt     DateTime? @map("deleted_at")
  deletedById   String?   @map("deleted_by") @db.VarChar(36)
  deletedReason String?   @map("deleted_reason") @db.VarChar(255)

  reporter   User  @relation("ReporterRelation", fields: [reporterId], references: [id], onDelete: Restrict)
  assignedTo User? @relation("AssigneeRelation", fields: [assignedToId], references: [id], onDelete: SetNull)

  deletedBy User? @relation("ReportDeletedByRelation", fields: [deletedById], references: [id], onDelete: SetNull)

  photos ReportPhoto[]
  verifications ReportVerification[]
  comments      ReportComment[]
  statusHistory ReportStatusHistory[]

  @@index([status])
  @@index([reporterId])
  @@index([assignedToId])

  @@index([deletedAt])
  @@index([status, deletedAt])
  @@index([reporterId, deletedAt])

  @@map("reports")
}

model ReportVerification {
  id          String             @id @default(uuid()) @db.VarChar(36)
  reportId    String             @map("report_id") @db.VarChar(36)
  validatorId String             @map("validator_id") @db.VarChar(36)
  result      VerificationResult
  comment     String?            @db.Text
  createdAt   DateTime           @default(now()) @map("created_at")

  report    Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  validator User   @relation("ValidatorRelation", fields: [validatorId], references: [id], onDelete: Restrict)

  @@unique([reportId, validatorId]) 
  @@index([reportId])
  @@index([validatorId])

  @@map("report_verifications")
}

model ReportComment {
  id        String   @id @default(uuid()) @db.VarChar(36)
  reportId  String   @map("report_id") @db.VarChar(36)
  userId    String   @map("user_id") @db.VarChar(36)
  comment   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([reportId])
  @@index([userId])

  @@map("report_comments")
}

model ReportStatusHistory {
  id        String        @id @default(uuid()) @db.VarChar(36)
  reportId  String        @map("report_id") @db.VarChar(36)
  changedBy String        @map("changed_by") @db.VarChar(36)
  oldStatus ReportStatus? @map("old_status")
  newStatus ReportStatus  @map("new_status")
  remarks   String?       @db.VarChar(255)
  createdAt DateTime      @default(now()) @map("created_at")

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  author User   @relation("StatusChangedByRelation", fields: [changedBy], references: [id], onDelete: Restrict)

  @@index([reportId])
  @@index([changedBy])

  @@map("report_status_history")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.VarChar(36)
  userId     String   @map("user_id") @db.VarChar(36)
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   String?  @map("entity_id") @db.VarChar(191)
  details    String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([entityType, entityId])

  @@map("audit_logs")
}

model ReportPhoto {
  id             String   @id @default(uuid())
  reportId       String   @map("report_id")
  url            String   @db.Text
  provider       String?  @db.VarChar(50)
  providerFileId String?  @map("provider_file_id") @db.VarChar(255)
  mimeType       String?  @map("mime_type") @db.VarChar(100)
  sizeBytes      Int?     @map("size_bytes")
  createdAt      DateTime @default(now()) @map("created_at")

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@map("report_photos")
}

model UserProfile {
  userId String @id @map("user_id") @db.VarChar(36)

  // Avatar
  avatarUrl            String? @map("avatar_url") @db.Text
  avatarProvider       String? @map("avatar_provider") @db.VarChar(50)
  avatarProviderFileId String? @map("avatar_provider_file_id") @db.VarChar(255)

  // Barangay / location (plain text)
  barangay         String? @db.VarChar(100)
  cityMunicipality String? @map("city_municipality") @db.VarChar(100)
  province         String? @db.VarChar(100)
  postalCode       String? @map("postal_code") @db.VarChar(20)

  privatePayload String? @map("private_payload") @db.LongText

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([barangay])
  @@index([cityMunicipality])
  @@map("user_profiles")
}

model UserSettings {
  userId String @id @map("user_id") @db.VarChar(36)

  // Encrypted JSON blob
  payload String @db.LongText

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model AuditLogArchive {
  // NOTE: id is NOT @id because partitioned tables require
  // PK/UNIQUE keys to include the partition column (createdAt).
  id         String   @db.VarChar(36)
  userId     String   @map("user_id") @db.VarChar(36)
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   String?  @map("entity_id") @db.VarChar(191)
  details    String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)

  // composite PK required for partitioning by createdAt
  @@id([createdAt, id])

  // helpful indexes
  @@index([id])
  @@index([userId])
  @@index([entityType, entityId])

  @@map("audit_logs_archive")
}